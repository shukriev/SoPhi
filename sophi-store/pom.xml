<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sophi</groupId>
        <artifactId>sophi-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sophi-store</artifactId>
    <name>Sophi — Store</name>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <!-- Single source of truth for the ArcadeDB version now that sophi-memory's own
                 copy of this dependency is removed in Task 2. -->
            <version>26.5.1</version>
            <exclusions>
                <!-- ~62 MB of GraalVM (js-language 25 MB, icu4j 17 MB, truffle-api 13 MB, regex
                     3.7 MB, polyglot, truffle-runtime), pulled in only for ArcadeDB's JavaScript
                     query engine and polyglot stored functions — nothing here runs either; every
                     query goes through the SQL engine. Safe to drop: GraalPolyglotEngine's static
                     init catches Throwable and falls back to an empty supported-language set, so
                     QueryEngineManager just registers no polyglot engine. Also skips Truffle's
                     runtime init (~200 classes) at first database open. -->
                <exclusion>
                    <groupId>org.graalvm.polyglot</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.graalvm.js</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.graalvm.sdk</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-runner-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

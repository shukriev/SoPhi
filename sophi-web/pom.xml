<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sophi</groupId>
        <artifactId>sophi-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sophi-web</artifactId>
    <name>Sophi — Web Interface</name>

    <dependencies>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-extensions</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-learning</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-skills</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-schedule</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-runner-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

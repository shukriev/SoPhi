#!/usr/bin/env bash
# Fake `sophi --mode rpc` for harness-test.sh: speaks the JSON-lines protocol on stdin/stdout.
# Per prompt/goal line the FIRST turn performs the $FAKE_DO actions in order (later turns just end).
home="${1#-Duser.home=}"; s="$home/.sophi/sessions/fake.jsonl"; mkdir -p "${s%/*}"
ev() { jq -nc "$@"; }
case " $FAKE_DO " in *" nostart "*) echo "usage error: no model server" >&2; exit 2 ;; esac
mem=true; reason=null; case " $FAKE_DO " in *" memoff "*) mem=false; reason='"embeddings endpoint unreachable"' ;; esac
ev --argjson m "$mem" --argjson r "$reason" '{type:"ready",sessionId:"fake",model:"m",provider:"p",memory:({enabled:$m}+(if $r then {reason:$r} else {} end))}'
first=1
while IFS= read -r line; do
  kind="$(jq -r '.type' <<< "$line")"
  [ "$kind" = prompt ] || [ "$kind" = goal ] || continue
  ev --arg i "$(jq -r '.text' <<< "$line")" '{type:"turn_started",input:$i}'
  stop=Completed
  if [ $first = 1 ]; then
    first=0
    for a in $FAKE_DO; do
      case "$a" in
        answer) echo parse_amount > answer.txt ;;
        sleep:*) sleep "${a#sleep:}" ;;
        ask:*) t="${a#ask:}"
          ev --arg t "$t" '{type:"confirmation_requested",requests:[{callId:("c-"+$t),toolName:$t,argumentsJson:"{}",riskLevel:"HIGH_RISK"}]}'
          IFS= read -r reply
          [ "$(jq -r '.approved' <<< "$reply")" = true ] || \
            echo "{\"role\":\"TOOL_RESULT\",\"content\":\"Error: Tool '$t' execution denied by confirmation policy\"}" >> "$s" ;;
        call) printf '{"role":"ASSISTANT","content":"","metadata":{"toolCalls":"[{\\"id\\":\\"c1\\",\\"name\\":\\"invoke_claude_code\\",\\"argumentsJson\\":\\"{\\\\\\"project_path\\\\\\":\\\\\\"%s\\\\\\"}\\"}]"}}\n' "$PWD" >> "$s" ;;
        call-elsewhere) printf '{"role":"ASSISTANT","content":"","metadata":{"toolCalls":"[{\\"id\\":\\"c1\\",\\"name\\":\\"invoke_claude_code\\",\\"argumentsJson\\":\\"{\\\\\\"project_path\\\\\\":\\\\\\"/Users/someone/real-repo\\\\\\"}\\"}]"}}\n' >> "$s" ;;
        denied) echo "{\"role\":\"TOOL_RESULT\",\"content\":\"Error: Tool 'invoke_claude_code' execution denied by confirmation policy\"}" >> "$s" ;;
        leak) echo '{"role":"USER","content":"cat evals/playbook/refs.sh"}' >> "$s" ;;
        cal) osascript -e 'return 1' >/dev/null 2>&1 && echo parse_amount > answer.txt ;;
        llmerror) stop=Error ;;
        solve:*) ( source "$PB/refs.sh"; "ref_${a#solve:}" ) ;;
        goalsolve:*) [ "$kind" = goal ] && ( source "$PB/refs.sh"; "ref_${a#goalsolve:}" ) ;;  # solves only if sent as a goal
      esac
    done
  fi
  ev --arg s "$stop" '{type:"turn_ended",reply:"",stopReason:$s}'
done
ev '{type:"exited"}'

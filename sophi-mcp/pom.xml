<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sophi</groupId>
        <artifactId>sophi-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sophi-mcp</artifactId>
    <name>Sophi — MCP Client</name>

    <dependencies>
        <dependency>
            <groupId>dev.sophi</groupId>
            <artifactId>sophi-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-serialization-json</artifactId>
            <version>${serialization.version}</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol</groupId>
            <artifactId>kotlin-sdk-jvm</artifactId>
        </dependency>
        <!--
            The MCP SDK's client module depends on `ktor-client-core-jvm` but does not bundle a
            concrete HTTP client engine (discovered at runtime: `StreamableHttpMcpConnector`
            failed with "Failed to find HTTP client engine implementation" until this was added).
            CIO is a pure-Kotlin engine (no extra native/OS deps) and matches the server-side CIO
            engine used by the test fixture, so it is used here too, at the same 3.4.3 version.
            This is main-scoped (not test-scoped): real callers of StreamableHttpMcpConnector need
            an engine on the classpath too.
        -->
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-client-cio-jvm</artifactId>
            <version>3.4.3</version>
        </dependency>
        <!--
            NOTE: the bare `io.ktor:ktor-server-cio`/`ktor-server-core` artifacts (no "-jvm"
            suffix) are Kotlin-Multiplatform metadata-only jars with zero real .class files
            (same trap as the bare `kotlin-sdk` artifact discovered in Task 3) — verified by
            downloading and inspecting the jar contents.

            `kotlin-sdk-jvm` (declared above) transitively drags in `kotlin-sdk-server-jvm`,
            which in turn pulls `ktor-server-core-jvm:3.4.3` transitively (confirmed via
            `mvn dependency:tree -pl sophi-mcp`). It's declared explicitly here anyway, pinned to
            test scope, for two reasons: (1) clarity — the test fixtures (TestMcpHttpServer) use
            it directly, so it should show up as a first-class dependency rather than an implicit
            transitive one; (2) safety — without the explicit test-scoped declaration, the
            transitive resolution is ambiguous about scope (conflicting `compile`/`runtime` scopes
            reach it via different paths through the SDK's dependency tree), so pinning it
            explicitly avoids it leaking onto the main compile classpath.

            `ktor-server-cio-jvm` (the CIO engine) is NOT transitively provided by the SDK at all
            and must be added explicitly, at the same 3.4.3 version, to avoid binary incompatibility
            with the client-side Ktor artifacts.
        -->
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-server-cio-jvm</artifactId>
            <version>3.4.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-server-core-jvm</artifactId>
            <version>3.4.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-runner-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
